{
  "name": "local-poker-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ai": "vitest run tests/ai",
    "test:ai:experience": "vitest run tests/ai/experienceSimulation.test.ts tests/ai/experienceMetrics.test.ts",
    "typecheck": "tsc -b --pretty false",
    "test:simulation": "vitest run tests/simulation tests/release"
    ,"test:cash-buyin": "vitest run tests/career/cashBuyIn.test.ts tests/career/cashBuyInConservation.test.ts tests/storage/cashBuyInRecovery.test.ts"
    ,"test:tournament": "vitest run tests/tournament tests/game/dealerDynamicSeats.test.ts"
  },
  "dependencies": {
    "@hivetech/poker-engine": "1.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.4"
  }
}
